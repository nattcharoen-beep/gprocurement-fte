# ==============================================================================
# FTE B2G Command Center - Environment Configuration Template (.env.example)
# บริษัท ไฟร์เทรดเอ็นจิเนียริ่ง จำกัด (มหาชน) (Firetrade Engineering PCL - FTE)
#
# วิธีใช้งาน:
# 1. คัดลอกไฟล์นี้เป็น .env (ไฟล์ .env ถูกป้องกันด้วย .gitignore ไม่หลุดขึ้น GitHub แน่นอน)
# 2. นำข้อมูลและ API Key ส่วนตัวมากรอกลงในช่องว่างด้านล่าง
# ==============================================================================

# ข้อมูลผู้ดูแลระบบ (Admin Superuser)
ADMIN_EMAIL=
ADMIN_PASSWORD=
RECOVERY_KEY=

# Gmail SMTP สำหรับส่งอีเมลสรุปงานประมูลรายวัน (Daily Tender Digest)
# *สร้าง App Password 16 หลักจาก Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENTS=

# CapSolver API Key สำหรับถอดรหัส Cloudflare Turnstile ในระบบ e-GP process5 อัตโนมัติ
CAPSOLVER_API_KEY=

# Cloudflare D1 Backend Worker API
D1_API_URL=https://gprocurement-fte.workers.dev
D1_API_KEY=

# Cloudflare Pages Frontend URL (Optional)
PAGES_URL=https://fte-finder.pages.dev
